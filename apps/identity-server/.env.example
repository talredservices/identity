APP_NAME="Talred Identity"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8100
IDENTITY_CONSOLE_URL=http://127.0.0.1:3100

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

LOG_CHANNEL=stack
LOG_STACK=single
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=identity
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=file
CACHE_STORE=file
QUEUE_CONNECTION=sync
FILESYSTEM_DISK=local
IDENTITY_BRANDING_DISK=public

BCRYPT_ROUNDS=12
ZOLTA_ATTR_ROUTE_CACHE=true
ZOLTA_ATTR_ROUTE_ENSURE_FRESH_ON_BOOT=true
IDENTITY_ACCESS_TOKEN_TTL_MINUTES=15
IDENTITY_REFRESH_TOKEN_TTL_DAYS=30
IDENTITY_INVITATION_TTL_HOURS=72
IDENTITY_EMAIL_VERIFICATION_TTL_MINUTES=15
IDENTITY_PASSWORD_RESET_TTL_MINUTES=60
IDENTITY_EXPOSE_DEVELOPMENT_TOKENS=true
IDENTITY_PASSWORD_RESET_URL=http://127.0.0.1:3100/auth/reset-password
IDENTITY_PROJECT_DELETION_GRACE_DAYS=30
IDENTITY_PROTECTED_PROJECT_SLUGS=identity-console

# Optional social authentication compatibility provider.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://127.0.0.1:3100/auth/google

TELESCOPE_ENABLED=true
TELESCOPE_PATH=telescope

MAIL_MAILER=log
MAIL_FROM_ADDRESS="identity@example.com"
MAIL_FROM_NAME="${APP_NAME}"
