{
    "$schema": "https://getcomposer.org/schema.json",
    "name": "talred/identity",
    "type": "project",
    "description": "Standalone Laravel identity API for multi-project accounts, RBAC, confidential clients, and token introspection.",
    "keywords": [
        "laravel",
        "identity",
        "identity-provider",
        "api",
        "sanctum",
        "rbac",
        "cqrs",
        "talred"
    ],
    "license": "Apache-2.0",
    "homepage": "https://github.com/talredservices/identity",
    "authors": [
        {
            "name": "Redouane Taleb",
            "homepage": "https://github.com/redouaneT",
            "role": "Maintainer"
        }
    ],
    "support": {
        "issues": "https://github.com/talredservices/identity/issues",
        "source": "https://github.com/talredservices/identity"
    },
    "require": {
        "php": "^8.3",
        "darkaonline/l5-swagger": "^11.0",
        "laravel/framework": "^13.0",
        "laravel/sanctum": "^4.0",
        "laravel/socialite": "^5.21",
        "laravel/tinker": "^3.0",
        "talred/php": "^1.0"
    },
    "require-dev": {
        "fakerphp/faker": "^1.23",
        "laravel/boost": "^2.2",
        "laravel/pail": "^1.2.5",
        "laravel/pint": "^1.27",
        "laravel/telescope": "^5.22",
        "mockery/mockery": "^1.6",
        "nunomaduro/collision": "^8.6",
        "phpmd/phpmd": "^2.15",
        "phpstan/phpstan": "*",
        "phpunit/phpunit": "^12.5.12",
        "rector/rector": "^2.2"
    },
    "autoload": {
        "psr-4": {
            "App\\": "app/",
            "Database\\Factories\\": "database/factories/",
            "Database\\Seeders\\": "database/seeders/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        }
    },
    "scripts": {
        "setup": [
            "composer install",
            "@php -r \"file_exists('.env') || copy('.env.example', '.env');\"",
            "@php artisan key:generate",
            "@php -r \"file_exists('database/database.sqlite') || touch('database/database.sqlite');\"",
            "@php artisan migrate --force"
        ],
        "dev": [
            "Composer\\Config::disableProcessTimeout",
            "npx concurrently \"php artisan queue:work --tries=3 --timeout=60\" \"php artisan serve --host=127.0.0.1 --port=8100\" \"php artisan schedule:work\""
        ],
        "test": [
            "@php artisan config:clear --ansi",
            "@php artisan test"
        ],
        "lint": "@php vendor/bin/pint --test",
        "format": "@php vendor/bin/pint",
        "check": [
            "@composer validate --strict",
            "@lint",
            "@test"
        ],
        "security:audit": "@composer audit",
        "cloud:build": [
            "@php artisan optimize --ansi"
        ],
        "cloud:deploy": [
            "@php artisan migrate --force --ansi"
        ],
        "post-autoload-dump": [
            "Illuminate\\Foundation\\ComposerScripts::postAutoloadDump",
            "@php artisan package:discover --ansi"
        ],
        "post-update-cmd": [
            "@php artisan vendor:publish --tag=laravel-assets --ansi --force",
            "@php artisan boost:update --ansi"
        ],
        "post-root-package-install": [
            "@php -r \"file_exists('.env') || copy('.env.example', '.env');\""
        ],
        "post-create-project-cmd": [
            "@php artisan key:generate --ansi",
            "@php -r \"file_exists('database/database.sqlite') || touch('database/database.sqlite');\"",
            "@php artisan migrate --graceful --ansi"
        ],
        "pre-package-uninstall": [
            "Illuminate\\Foundation\\ComposerScripts::prePackageUninstall"
        ]
    },
    "extra": {
        "laravel": {
            "dont-discover": []
        }
    },
    "config": {
        "optimize-autoloader": true,
        "preferred-install": "dist",
        "sort-packages": true,
        "allow-plugins": {
            "pestphp/pest-plugin": true,
            "php-http/discovery": true
        }
    },
    "minimum-stability": "dev",
    "prefer-stable": true
}
