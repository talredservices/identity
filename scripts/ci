#!/usr/bin/env bash
set -euo pipefail

root="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
cd "$root"

frontend() {
  CI=true pnpm install --frozen-lockfile
  pnpm lint
  pnpm build
}

backend() {
  for extension in pdo_sqlite sqlite3 gd; do
    php -m | grep -Fxq "$extension" || {
      echo "PHP extension is required by the GitHub test job: $extension" >&2
      return 78
    }
  done
  composer --working-dir=apps/identity-server validate --strict
  composer --working-dir=apps/identity-server install --prefer-dist --no-interaction --no-progress
  composer --working-dir=apps/identity-server lint
  composer --working-dir=apps/identity-server test
}

security() {
  ./scripts/check-dco.sh origin/main
  ./scripts/check-tracked-secrets.sh
  IDENTITY_ENV_FILE=.env.production.example docker compose --env-file .env.production.example config --quiet
  pnpm run security:audit:js
  composer --working-dir=apps/identity-server audit --locked
}

fast() {
  git diff --check
  frontend
  backend
  security
}

case "${1:-pre-push}" in
  fast|pre-push) fast ;;
  full) fast ;;
  *) echo "Usage: $0 {fast|pre-push|full}" >&2; exit 64 ;;
esac
