FROM php:8.3.36-cli-alpine

RUN apk add --no-cache $PHPIZE_DEPS linux-headers icu-dev libzip-dev oniguruma-dev freetype-dev libjpeg-turbo-dev libpng-dev git \
    && docker-php-ext-configure gd --with-freetype --with-jpeg \
    && docker-php-ext-install bcmath gd intl mbstring pdo_mysql zip \
    && pecl install redis-6.2.0 xdebug \
    && docker-php-ext-enable redis xdebug \
    && apk del $PHPIZE_DEPS

COPY --from=composer:2 /usr/bin/composer /usr/bin/composer

WORKDIR /var/www/html
