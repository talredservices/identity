# Copy to .env.production and replace every <...> placeholder through your secret manager.
# Never commit the resulting file. Public URLs must use HTTPS behind your reverse proxy.
IDENTITY_API_PUBLIC_URL=https://identity-api.example.com
IDENTITY_CONSOLE_PUBLIC_URL=https://identity.example.com
IDENTITY_BIND_ADDRESS=127.0.0.1
IDENTITY_API_PORT=8100
IDENTITY_CONSOLE_PORT=3100

APP_KEY=<generate-with-php-artisan-key-generate-show>
DB_DATABASE=zolta_identity
DB_USERNAME=zolta_identity
DB_PASSWORD=<generate-a-unique-database-password>
MYSQL_ROOT_PASSWORD=<generate-a-separate-root-password>

NUXT_SESSION_PASSWORD=<generate-at-least-32-random-characters>
IDENTITY_PROJECT=identity-console
# Created by `php artisan identity:bootstrap` after the first migration.
IDENTITY_CLIENT_ID=<identity-console-client-id>
IDENTITY_CLIENT_SECRET=<identity-console-client-secret>
IDENTITY_HOSTED_APPLICATIONS_TOKEN=<generate-a-64-character-internal-token>
IDENTITY_PASSWORD_RESET_URL=https://identity.example.com/auth/reset-password

MAIL_MAILER=smtp
MAIL_HOST=smtp.example.com
MAIL_PORT=587
MAIL_USERNAME=<smtp-username>
MAIL_PASSWORD=<smtp-password>
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS=identity@example.com
MAIL_FROM_NAME="Identity Console"

NUXT_PUBLIC_IDENTITY_AUTH_PRODUCT_NAME="Identity Console"
